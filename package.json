{
    "name": "@marsup/joi-env",
    "version": "1.0.0",
    "description": "Joi extension to read values from environment variables",
    "keywords": [
        "configuration",
        "env",
        "environment",
        "joi"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git://github.com/Marsup/joi-env.git"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": "./dist/index.mjs",
        "./package.json": "./package.json"
    },
    "scripts": {
        "prepare": "node --run build",
        "test": "vitest run --coverage",
        "typecheck": "tsc --noEmit",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "fmt": "oxfmt --check",
        "fmt:fix": "oxfmt",
        "build": "tsdown"
    },
    "devDependencies": {
        "@hapi/oxc-plugin": "^1.0.4",
        "@types/node": "^22.20.1",
        "@vitest/coverage-v8": "^4.1.10",
        "joi": "^18.3.0",
        "oxfmt": "^0.61.0",
        "oxlint": "^1.76.0",
        "tsdown": "^0.22.14",
        "typescript": "^6.0.3",
        "vitest": "^4.1.10"
    },
    "peerDependencies": {
        "joi": "^18.3.0"
    },
    "engines": {
        "node": ">=22"
    }
}
